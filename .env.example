# === 服务器基础配置 ===
PORT=1031
NODE_ENV=development

# === 数据库配置 ===
DATABASE_URL=file:./database/app.db

# === JWT 认证 ===
JWT_SECRET=your-secret-key-here-must-be-at-least-32-characters-long!!
JWT_EXPIRES_IN=7d

# === Redis 配置 ===
REDIS_URL=redis://localhost:6379

# === CORS 配置 ===
CORS_ORIGIN=http://localhost:3031

# === 文件上传配置 ===
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# === 速率限制 ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# === 外部服务 URL ===
NIUMA_ENGINE_URL=http://localhost:1023

# === AI 提供商 API 密钥 ===
# 从 https://dashscope.aliyun.com 获取
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# 从 https://www.deepseek.com 获取
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# OpenAI API Key (可选)
OPENAI_API_KEY=sk-your-openai-api-key-here

# === 数据加密 ===
# 32字符的加密密钥，用于加密敏感数据
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-character-encryption-key-here!!
